{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "variable",
	"windowSizingY": "variable",
	"windowMinWidth": 760,
	"windowMinHeight": 480,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"rightMargin": 0,
	"bottomMargin": 16,
	"events": [
		"onLoad",
		"onUnload"
	],
	"windowTitle": ":xliff:TicketFinder_WindowTitle",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"headerBand": {
					"type": "rectangle",
					"top": 0,
					"left": 0,
					"width": 960,
					"height": 76,
					"sizingX": "grow",
					"class": "tfHeader"
				},
				"headerTitle": {
					"type": "text",
					"text": ":xliff:TicketFinder_Title",
					"top": 14,
					"left": 24,
					"width": 600,
					"height": 30,
					"class": "tfHeaderTitle"
				},
				"headerSubtitle": {
					"type": "text",
					"text": ":xliff:TicketFinder_Subtitle",
					"top": 46,
					"left": 24,
					"width": 900,
					"height": 18,
					"sizingX": "grow",
					"class": "tfHeaderSubtitle"
				},
				"queryInput": {
					"type": "input",
					"top": 96,
					"left": 24,
					"width": 696,
					"height": 27,
					"sizingX": "grow",
					"dataSource": "Form.queryText",
					"placeholder": ":xliff:TicketFinder_QueryPlaceholder",
					"class": "tfQuery"
				},
				"searchButton": {
					"type": "button",
					"text": ":xliff:TicketFinder_Search",
					"top": 96,
					"left": 732,
					"width": 100,
					"sizingX": "move",
					"defaultButton": true,
					"class": "default",
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/searchButton.4dm"
				},
				"clearButton": {
					"type": "button",
					"text": ":xliff:TicketFinder_Clear",
					"top": 96,
					"left": 836,
					"width": 100,
					"sizingX": "move",
					"class": "default",
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/clearButton.4dm"
				},
				"samplesDropdown": {
					"type": "dropdown",
					"top": 136,
					"left": 24,
					"width": 320,
					"height": 27,
					"dataSource": "Form.samples",
					"events": [
						"onDataChange"
					],
					"method": "ObjectMethods/samplesDropdown.4dm"
				},
				"indexCheckbox": {
					"type": "checkbox",
					"text": ":xliff:TicketFinder_UseIndex",
					"top": 140,
					"left": 364,
					"width": 260,
					"height": 20,
					"dataSource": "Form.indexedSearch",
					"dataSourceTypeHint": "boolean"
				},
				"thresholdLabel": {
					"type": "text",
					"text": ":xliff:TicketFinder_Threshold",
					"top": 141,
					"left": 700,
					"width": 150,
					"height": 17,
					"sizingX": "move",
					"class": "tfLabel"
				},
				"thresholdInput": {
					"type": "input",
					"top": 136,
					"left": 856,
					"width": 80,
					"height": 27,
					"sizingX": "move",
					"dataSource": "Form.threshold",
					"dataSourceTypeHint": "number",
					"numberFormat": "0.00",
					"textAlign": "right"
				},
				"summaryText": {
					"type": "input",
					"top": 176,
					"left": 24,
					"width": 912,
					"height": 18,
					"sizingX": "grow",
					"dataSource": "Form.summary",
					"dataSourceTypeHint": "text",
					"enterable": false,
					"focusable": false,
					"contextMenu": "none",
					"borderStyle": "none",
					"fill": "transparent",
					"class": "tfSummary"
				},
				"timingsText": {
					"type": "input",
					"top": 198,
					"left": 24,
					"width": 912,
					"height": 17,
					"sizingX": "grow",
					"dataSource": "Form.timingsText",
					"dataSourceTypeHint": "text",
					"enterable": false,
					"focusable": false,
					"contextMenu": "none",
					"borderStyle": "none",
					"fill": "transparent",
					"class": "tfCaption"
				},
				"ticketList": {
					"type": "listbox",
					"top": 224,
					"left": 24,
					"width": 912,
					"height": 400,
					"sizingX": "grow",
					"sizingY": "grow",
					"listboxType": "collection",
					"dataSource": "Form.tickets",
					"currentItemSource": "Form.ticket",
					"selectionMode": "single",
					"rowHeight": "24px",
					"headerHeight": "26px",
					"hideFocusRing": true,
					"resizingMode": "rightToLeft",
					"truncateMode": "withEllipsis",
					"verticalAlign": "middle",
					"class": "tfList",
					"columns": [
						{
							"name": "scoreColumn",
							"dataSource": "This.Vector.cosineSimilarity(Form.queryVector)",
							"width": 70,
							"header": {
								"name": "scoreColumnHeader",
								"text": ":xliff:TicketFinder_ColumnScore"
							},
							"footer": {
								"name": "scoreColumnFooter"
							},
							"numberFormat": "0.000",
							"textAlign": "right",
							"dataSourceTypeHint": "number",
							"enterable": false
						},
						{
							"name": "idColumn",
							"dataSource": "This.Id",
							"width": 96,
							"header": {
								"name": "idColumnHeader",
								"text": ":xliff:TicketFinder_ColumnId"
							},
							"footer": {
								"name": "idColumnFooter"
							},
							"enterable": false
						},
						{
							"name": "priorityColumn",
							"dataSource": "This.Priority",
							"width": 64,
							"header": {
								"name": "priorityColumnHeader",
								"text": ":xliff:TicketFinder_ColumnPriority"
							},
							"footer": {
								"name": "priorityColumnFooter"
							},
							"textAlign": "center",
							"enterable": false
						},
						{
							"name": "categoryColumn",
							"dataSource": "This.Category",
							"width": 170,
							"header": {
								"name": "categoryColumnHeader",
								"text": ":xliff:TicketFinder_ColumnCategory"
							},
							"footer": {
								"name": "categoryColumnFooter"
							},
							"enterable": false
						},
						{
							"name": "titleColumn",
							"dataSource": "This.Title",
							"width": 260,
							"header": {
								"name": "titleColumnHeader",
								"text": ":xliff:TicketFinder_ColumnTitle"
							},
							"footer": {
								"name": "titleColumnFooter"
							},
							"enterable": false
						},
						{
							"name": "descriptionColumn",
							"dataSource": "This.Description",
							"width": 250,
							"header": {
								"name": "descriptionColumnHeader",
								"text": ":xliff:TicketFinder_ColumnDescription"
							},
							"footer": {
								"name": "descriptionColumnFooter"
							},
							"enterable": false,
							"minWidth": 120
						}
					],
					"scrollbarHorizontal": "hidden"
				},
				"modelStatusText": {
					"type": "input",
					"top": 636,
					"left": 24,
					"width": 912,
					"height": 17,
					"sizingX": "grow",
					"sizingY": "move",
					"dataSource": "Form.modelStatus",
					"dataSourceTypeHint": "text",
					"enterable": false,
					"focusable": false,
					"contextMenu": "none",
					"borderStyle": "none",
					"fill": "transparent",
					"class": "tfCaption"
				}
			}
		}
	],
	"editor": {
		"activeView": "View 1",
		"defaultView": "View 1",
		"views": {
			"View 1": {}
		}
	},
	"method": "method.4dm"
}
