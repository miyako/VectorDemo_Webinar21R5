<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
	<file datatype="plaintext" original="messages" source-language="en" target-language="ja">
		<body>
			<trans-unit id="TicketFinder_Samples" resname="TicketFinder_Samples">
				<source>Sample questions</source>
				<target>質問の例</target>
			</trans-unit>
			<trans-unit id="Model_Ready" resname="Model_Ready">
				<source>Embedding model ready (ruri-v3-310m, running locally)</source>
				<target>埋め込みモデル準備完了（ruri-v3-310m・ローカル実行）</target>
			</trans-unit>
			<trans-unit id="Model_Downloading" resname="Model_Downloading">
				<source>Downloading the embedding model… {percent}%</source>
				<target>埋め込みモデルをダウンロード中… {percent}%</target>
			</trans-unit>
			<trans-unit id="Model_Loading" resname="Model_Loading">
				<source>Starting the embedding model…</source>
				<target>埋め込みモデルを起動中…</target>
			</trans-unit>
			<trans-unit id="Model_Stopped" resname="Model_Stopped">
				<source>The embedding model has stopped</source>
				<target>埋め込みモデルが停止しました</target>
			</trans-unit>
			<trans-unit id="Model_Error" resname="Model_Error">
				<source>Embedding model error:</source>
				<target>埋め込みモデルのエラー：</target>
			</trans-unit>
			<trans-unit id="Search_Embedding" resname="Search_Embedding">
				<source>Vectorising the question…</source>
				<target>質問をベクトル化しています…</target>
			</trans-unit>
			<trans-unit id="Search_Failed" resname="Search_Failed">
				<source>Search failed:</source>
				<target>検索に失敗しました：</target>
			</trans-unit>
			<trans-unit id="Search_ResultIndexed" resname="Search_ResultIndexed">
				<source>{count} tickets in {ms} ms (vector index)</source>
				<target>{count} 件・{ms} ミリ秒（ベクトルインデックスあり）</target>
			</trans-unit>
			<trans-unit id="Search_ResultScan" resname="Search_ResultScan">
				<source>{count} tickets in {ms} ms (full scan, no index)</source>
				<target>{count} 件・{ms} ミリ秒（インデックスなし・全件走査）</target>
			</trans-unit>
			<trans-unit id="Search_Comparison" resname="Search_Comparison">
				<source>Last search time: with index {indexed} ms / without index {scan} ms</source>
				<target>直近の検索時間：インデックスあり {indexed} ミリ秒 ／ なし {scan} ミリ秒</target>
			</trans-unit>
			<trans-unit id="Search_NotMeasured" resname="Search_NotMeasured">
				<source>–</source>
				<target>–</target>
			</trans-unit>
		</body>
	</file>
</xliff>
